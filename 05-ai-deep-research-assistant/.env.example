# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: override the OpenAI model used for planning, subtopic research,
# and report writing. Must be a model that supports the Responses API tool
# `web_search` (see https://ai-sdk.dev/providers/ai-sdk-providers/openai).
RESEARCH_MODEL=gpt-4.1-mini

